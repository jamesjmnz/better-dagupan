{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "citizens-charter.schema.json",
  "title": "Citizen's Charter services",
  "description": "Services transcribed from the City Government of Dagupan's Citizen's Charter pages. Every text field is the city's wording as printed. A field the charter does not state is null or [], which means not verified yet, never does not exist. The charter's person-responsible column is deliberately not part of this schema, so a record carrying staff names is rejected. See docs/civic-data-verification.md. Mirrors CitizensCharterService in src/types/citizens-charter.ts.",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_number",
          "service_name",
          "office_division",
          "classification",
          "type_of_transaction",
          "who_may_avail",
          "requirements",
          "client_steps",
          "fees",
          "processing_time",
          "processing_time_status",
          "sources",
          "category_override"
        ],
        "properties": {
          "service_number": {
            "description": "The charter's own service number. Null: Dagupan's charter pages number none.",
            "type": ["string", "null"]
          },
          "service_name": {
            "description": "The service name as the charter page titles it.",
            "type": "string",
            "minLength": 1
          },
          "office_division": {
            "description": "The \"Office Division\" line, as printed.",
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "description": "The \"Classification\" line, as printed, or null when not stated.",
            "type": ["string", "null"],
            "enum": ["Simple", "Complex", "Highly Technical", null]
          },
          "type_of_transaction": {
            "description": "The \"Type of Transaction\" line, as printed.",
            "type": ["string", "null"]
          },
          "who_may_avail": {
            "description": "The \"Who may Avail?\" text, as printed; lines are kept with \\n.",
            "type": ["string", "null"]
          },
          "requirements": {
            "description": "The checklist of requirements table, one entry per row.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["requirement", "where_to_secure"],
              "additionalProperties": false,
              "properties": {
                "requirement": { "type": "string", "minLength": 1 },
                "where_to_secure": {
                  "description": "As printed; null where the charter leaves the cell blank.",
                  "type": ["string", "null"]
                }
              }
            }
          },
          "client_steps": {
            "description": "The client-steps table. A step is a client-step cell and the agency rows that follow it.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step", "action", "agency_actions"],
              "additionalProperties": false,
              "properties": {
                "step": { "type": "integer", "minimum": 1 },
                "action": { "type": "string", "minLength": 1 },
                "sub_steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["letter", "action"],
                    "additionalProperties": false,
                    "properties": {
                      "letter": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+$"
                      },
                      "action": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "agency_actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["action", "fees", "processing_time"],
                    "additionalProperties": false,
                    "properties": {
                      "number": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+$"
                      },
                      "action": { "type": "string", "minLength": 1 },
                      "fees": { "type": ["string", "null"] },
                      "processing_time": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          },
          "fees": {
            "description": "The single amount the charter states for the service, or null when it states none.",
            "type": ["object", "null"],
            "required": ["amount", "description"],
            "additionalProperties": false,
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^Php [0-9,]+\\.[0-9]{2}$"
              },
              "description": { "type": "string", "minLength": 1 }
            }
          },
          "processing_time": {
            "description": "The \"TOTAL PROCESSING TIME\" line, as printed, or null when not stated or withheld.",
            "type": ["string", "null"]
          },
          "processing_time_status": {
            "type": "string",
            "enum": ["stated", "not_stated", "conflicting"]
          },
          "sources": {
            "description": "Ids of the civic sources this record is transcribed from.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "category_override": {
            "description": "Display category chosen by this portal, not by the city.",
            "type": "string",
            "enum": [
              "business-trade-investment",
              "taxation-payments",
              "infrastructure-public-works",
              "certificates-vital-records",
              "agriculture-economic-development",
              "public-safety-security",
              "education-scholarship",
              "health-wellness",
              "social-services-assistance",
              "environment-natural-resources"
            ]
          }
        }
      }
    }
  }
}
